# Thor viewer GPU settings: WebGPU on the Adreno via turnip-kgsl-shim (see /code/projects/turnip-kgsl-shim).
# Activate by copying/renaming this file to ~/.config/thor-gpu/env ; remove that file to go back to plain WebGL-only.
THOR_SHIM=1
THOR_WEBGPU=1
THOR_PRELOAD=/data/data/com.termux/files/usr/lib/libno-dlopen.so
NO_DLOPEN_MATCH=libvk_swiftshader
